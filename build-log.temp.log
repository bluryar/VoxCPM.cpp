[Unit]
Description=VoxCPM Server - Audio Generation Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/VoxCPM.cpp/build-cuda/examples
ExecStart=/root/VoxCPM.cpp/build-cuda/examples/voxcpm-server   --host 0.0.0.0   --port 11435   --model-path /root/VoxCPM.cpp/models/voxcpm1.5-q4_k-audiovae-f16.gguf   --model-name voxcpm-1.5   --backend cuda   --voice-dir /root/VoxCPM.cpp/runtime/voices   --max-queue 4   --disable-auth
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment="CUDA_VISIBLE_DEVICES=0"

[Install]
WantedBy=multi-user.target
